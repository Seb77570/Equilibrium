{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Equilibrium",
  "version": "1.0.10",
  "identifier": "com.equilibrium.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Equilibrium Dashboard",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "transparent": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--allow-running-insecure-content --disable-features=SameSiteByDefaultCookies,CookiesWithoutSameSiteMustBeSecure,PartitionedCookies,ThirdPartyStoragePartitioning,msSameSiteCookieBlock,AutoupgradeMixedContent,BlockInsecurePrivateNetworkRequests"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
