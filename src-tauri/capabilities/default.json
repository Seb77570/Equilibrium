{
  "identifier": "default",
  "description": "Default capability for the app",
  "windows": ["*"],
  "remote": {
    "urls": [
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:default",
    "core:window:allow-set-fullscreen",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
